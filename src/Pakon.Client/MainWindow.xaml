<Window x:Class="Pakon.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Pakon" Width="1240" Height="820" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="#DED9CE" BorderThickness="0,0,0,1">
            <Grid Margin="34,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="P" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PAKON" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="35 mm film scanner" Foreground="{StaticResource MutedBrush}" FontSize="13"
                               Margin="14,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="14" Background="#E7EFEA" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#C59134" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ConnectionText" Text="Initializing scanner…" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Scan setup -->
        <Grid x:Name="SetupPage" Grid.Row="1" Margin="54,42" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="16,0,60,0">
                <TextBlock Text="35 MM WORKFLOW" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold"/>
                <TextBlock Text="Bring your film&#x0a;back into focus." FontFamily="Georgia" FontSize="48"
                           FontWeight="Bold" LineHeight="54" Margin="0,14,0,20"/>
                <TextBlock Text="Base 16 capture is selected automatically—the best quality available from the scanner. Choose the film stock and let Pakon handle the rest."
                           FontSize="16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="25"/>
                <Border Background="#EAE6DC" CornerRadius="10" Margin="0,28,0,0" Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="BASE 16" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="Maximum scanner resolution · 35 mm"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="34"
                    BorderBrush="#DED9CE" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="New scan" FontFamily="Georgia" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Film type" FontWeight="SemiBold" Margin="0,28,0,6"/>
                    <RadioButton x:Name="ColorNegativeRadio" Content="Color negative" GroupName="Film" IsChecked="True" Checked="FilmTypeChanged"/>
                    <RadioButton x:Name="ColorPositiveRadio" Content="Color positive / slide" GroupName="Film" Checked="FilmTypeChanged"/>
                    <RadioButton x:Name="BlackWhiteRadio" Content="Black &amp; white negative" GroupName="Film"
                                 Checked="FilmTypeChanged"/>
                    <Separator Margin="0,22"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Digital ICE" FontWeight="SemiBold"/>
                            <TextBlock Text="Infrared scratch and dust removal" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </StackPanel>
                        <CheckBox x:Name="IceCheckBox" Grid.Column="1" IsChecked="False"
                                  Checked="IceSelectionChanged" Unchecked="IceSelectionChanged"/>
                    </Grid>
                    <Border x:Name="BwIceNotice" Visibility="Collapsed" Background="#FFF0DB"
                            BorderBrush="#E8C488" BorderThickness="1" CornerRadius="8"
                            Padding="12" Margin="0,12,0,0">
                        <TextBlock Text="Digital ICE with black &amp; white mode uses the C-41 process and will only work with Ilford XP2 film."
                                   TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                    <Button x:Name="StartScanButton" Content="Start scanning" Background="{StaticResource AccentBrush}"
                            Margin="0,32,0,0" Click="StartScanClicked" IsEnabled="False"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Scan progress -->
        <Grid x:Name="ScanningPage" Grid.Row="1">
            <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ProgressTitle" Text="Starting Pakon" FontFamily="Georgia" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ScanStatusText" Text="Connecting to the scanner…" FontSize="15"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,34"/>
                <ProgressBar x:Name="ScanProgress" Height="12" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Keep the film path clear while the roll is moving." HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,18"/>
                <Button x:Name="ProgressCancelButton" Content="Cancel scan" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Margin="0,16,0,0" Click="CancelScanClicked"/>
            </StackPanel>
        </Grid>

        <!-- Review -->
        <Grid x:Name="ReviewPage" Grid.Row="1" Visibility="Collapsed" Margin="34,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,24,18">
                <StackPanel>
                    <TextBlock Text="Review your frames" FontFamily="Georgia" FontSize="30" FontWeight="Bold"/>
                    <TextBlock x:Name="ReviewSummaryText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="Select all" Style="{StaticResource SecondaryButton}" Padding="13,8" Margin="0,0,8,0" Click="SelectAllClicked"/>
                    <Button Content="Clear selection" Style="{StaticResource SecondaryButton}" Padding="13,8" Click="ClearSelectionClicked"/>
                </StackPanel>
            </Grid>
            <ItemsControl x:Name="FrameGrid" Grid.Row="1" Margin="0,0,24,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><primitives:UniformGrid Columns="3" Rows="3"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="FrameCard" Background="{StaticResource CardBrush}" BorderBrush="#D8D2C7" BorderThickness="1"
                                CornerRadius="10" Margin="5" Padding="7" MouseLeftButtonDown="FrameCardClicked">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Background="#252825" CornerRadius="6" ClipToBounds="True">
                                    <Image Source="{Binding Preview}" Stretch="Uniform"/>
                                </Border>
                                <Grid Grid.Row="1" Margin="3,8,3,1">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <CheckBox HorizontalAlignment="Right" IsChecked="{Binding IsIncluded}" ToolTip="Include when saving"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="FrameCard" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="FrameCard" Property="BorderThickness" Value="3"/>
                                <Setter TargetName="FrameCard" Property="Padding" Value="5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                <Setter TargetName="FrameCard" Property="Opacity" Value=".42"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,24,0">
                <Button x:Name="PreviousPageButton" Content="← Previous" Style="{StaticResource SecondaryButton}" Padding="14,8" Click="PreviousPageClicked"/>
                <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="18,0"/>
                <Button x:Name="NextPageButton" Content="Next →" Style="{StaticResource SecondaryButton}" Padding="14,8" Click="NextPageClicked"/>
            </StackPanel>

            <Border Grid.Column="1" Grid.RowSpan="3" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="24"
                    BorderBrush="#DED9CE" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="Continue to saving" Background="{StaticResource AccentBrush}"
                            Margin="0,22,0,0" Click="ContinueToSavingClicked"/>
                    <StackPanel>
                        <TextBlock x:Name="EditSelectionTitle" Text="Select a frame" FontFamily="Georgia" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="Click frames to edit one or several together." Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,6,0,20"/>
                        <UniformGrid Columns="2" Margin="0,0,0,18">
                            <Button Content="↶ 90°" Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,0,5,0" Click="RotateLeftClicked"/>
                            <Button Content="90° ↷" Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="5,0,0,0" Click="RotateRightClicked"/>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,0,0,18">
                            <Button Content="Include" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,5,0" Click="IncludeSelectedClicked"/>
                            <Button Content="Exclude" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="5,0,0,0" Click="ExcludeSelectedClicked"/>
                        </UniformGrid>
                        <TextBlock Text="Exposure (stops)" FontWeight="SemiBold"/>
                        <Slider x:Name="ExposureSlider" Minimum="-2" Maximum="2"
                                SmallChange="0.1" LargeChange="0.5" ValueChanged="AdjustmentChanged"/>
                        <TextBlock Text="Contrast" FontWeight="SemiBold"/>
                        <Slider x:Name="ContrastSlider" Minimum="-50" Maximum="50" ValueChanged="AdjustmentChanged"/>
                        <StackPanel x:Name="ColorBalancePanel">
                            <TextBlock Text="Color balance" FontWeight="SemiBold" Margin="0,6,0,4"/>
                            <TextBlock x:Name="RedBalanceLabel" Text="Red" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <Slider x:Name="RedSlider" Minimum="-35" Maximum="35" ValueChanged="AdjustmentChanged"/>
                            <TextBlock x:Name="GreenBalanceLabel" Text="Green" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <Slider x:Name="GreenSlider" Minimum="-35" Maximum="35" ValueChanged="AdjustmentChanged"/>
                            <TextBlock x:Name="BlueBalanceLabel" Text="Blue" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <Slider x:Name="BlueSlider" Minimum="-35" Maximum="35" ValueChanged="AdjustmentChanged"/>
                        </StackPanel>
                        <Button Content="Reset adjustments" Style="{StaticResource SecondaryButton}" Padding="12,8"
                                Margin="0,8,0,0" Click="ResetAdjustmentsClicked"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Save -->
        <Grid x:Name="SavePage" Grid.Row="1" Visibility="Collapsed" Margin="70,44">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
            <StackPanel Margin="20,0,70,0" VerticalAlignment="Center">
                <TextBlock Text="READY TO EXPORT" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="Give these frames&#x0a;a place to live." FontFamily="Georgia" FontSize="45" FontWeight="Bold"
                           LineHeight="52" Margin="0,14,0,18"/>
                <TextBlock x:Name="SaveSummaryText" FontSize="16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <Button Content="← Back to review" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Margin="0,28,0,0" Click="BackToReviewClicked"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="32"
                    BorderBrush="#DED9CE" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Save options" FontFamily="Georgia" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Destination folder" FontWeight="SemiBold" Margin="0,25,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputFolderTextBox" Height="39" Padding="10,8" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="13,8"
                                Margin="8,0,0,0" Click="BrowseClicked"/>
                    </Grid>
                    <TextBlock Text="Optional filename prefix" FontWeight="SemiBold" Margin="0,20,0,7"/>
                    <TextBox x:Name="PrefixTextBox" Height="39" Padding="10,8" VerticalContentAlignment="Center"/>
                    <TextBlock Text="DX frame names are used when available; otherwise frames are numbered in order."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,18"/>
                    <RadioButton x:Name="Png16Radio" GroupName="Format" IsChecked="True">
                        <StackPanel><TextBlock Text="16-bit PNG" FontWeight="SemiBold"/><TextBlock Text="Maximum editable quality" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="JpegRadio" GroupName="Format">
                        <StackPanel><TextBlock Text="8-bit JPEG · quality 95" FontWeight="SemiBold"/><TextBlock Text="Smaller, ready to share" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                    </RadioButton>
                    <Button x:Name="SaveButton" Content="Save selected frames" Background="{StaticResource AccentBrush}"
                            Margin="0,26,0,0" Click="SaveClicked"/>
                    <ProgressBar x:Name="SaveProgress" Height="7" Visibility="Collapsed" Margin="0,15,0,0" Foreground="{StaticResource GreenBrush}"/>
                    <TextBlock x:Name="SaveStatusText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextAlignment="Center" Margin="0,8,0,0"/>
                    <StackPanel x:Name="PostSaveActionsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <Button Content="Open output folder" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,8" Click="OpenOutputFolderClicked"/>
                        <Button Content="Scan a new roll / strip" Background="{StaticResource GreenBrush}"
                                Click="ScanAnotherRollClicked"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E9E5DB">
            <TextBlock x:Name="FooterText" Text="35 mm · Base 16 · Ready" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
